DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_CA=./supabase-root.crt
DATABASE_POOL_SIZE=10
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=12h
API_PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=
